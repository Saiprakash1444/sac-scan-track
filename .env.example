# Copy to .env for local dev. In production these are set in the Vercel dashboard
# (Project → Settings → Environment Variables). See docs/DEPLOYMENT.md.
#
# NOTE: VITE_* vars are inlined into the CLIENT bundle at build time and are
# therefore PUBLIC. Only the anon/publishable key belongs there — never a secret.

# ─── Supabase: public (safe to expose) ────────────────────────────────────────
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>

# Same values, read by SSR and server functions.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>

# ─── Supabase: SECRET ─────────────────────────────────────────────────────────
# service_role BYPASSES ROW LEVEL SECURITY. Server-only, never prefixed VITE_.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ─── Admin panel (/admin) ─────────────────────────────────────────────────────
# One shared password for the room computer. This is a separate auth system from
# member Supabase login — see CONTEXT.md §7.
SAC_ADMIN_PASSWORD=<a long random passphrase>

# Signing key for the "sac-admin" session cookie. Must be >= 32 chars.
# Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=<32+ random chars>

# ─── Vision AI: primary ───────────────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
# Image input is free of charge on Flash models.
GEMINI_API_KEY=<google ai studio key>
# Optional override if the model id is rotated.
GEMINI_MODEL=gemini-3.6-flash

# ─── Vision AI: fallback (optional) ───────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint that accepts image_url input.
# Used only when the primary is rate limited, out of credits, or down.
#
# Example — OpenRouter (https://openrouter.ai/keys), whose `openrouter/free`
# router auto-selects among currently-free vision models:
#   AI_FALLBACK_URL=https://openrouter.ai/api/v1/chat/completions
#   AI_FALLBACK_MODEL=openrouter/free
#   AI_FALLBACK_NAME=openrouter
AI_FALLBACK_API_KEY=
AI_FALLBACK_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_NAME=

# ─── Lovable (optional) ───────────────────────────────────────────────────────
# Only set inside Lovable Cloud. Tried last, so the Lovable editor preview keeps
# working. Leave empty on Vercel.
LOVABLE_API_KEY=
