# Copy to .env.test (gitignored) to run `npm run test:db`. PLACEHOLDERS ONLY.
#
# These must point at a SEPARATE Supabase project made for testing — never the
# production project. tests/db/guard.ts refuses to run unless all of this holds,
# including a sentinel row you create by hand in the TEST project only:
#
#   create table public.qa_sentinel (kind text primary key);
#   insert into public.qa_sentinel values ('isolated-test');
#
# Then apply every migration in supabase/migrations to that project.

TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
TEST_SUPABASE_ANON_KEY=<test-project-publishable-key>
TEST_SUPABASE_SERVICE_ROLE_KEY=<test-project-service-role-key>

# Set by a person, on purpose, after checking the three values above.
SAC_TEST_DB_CONFIRM=isolated-test-project
